record(bi, "$(P):$(R):regulation_ok") {
    field(DESC, "Regulation OK Status")
    field(DTYP, "asynUInt32Digital")
    field(INP, "@asynMask($(PORT),16,0x0040,1)")
    field(SCAN, "1 second")
    field(ZNAM, "NOT OK")
    field(ONAM, "OK")
}

record(mbbiDirect, "$(P):$(R):faults1") {
    field(DTYP, "asynUInt32Digital")
    field(INP, "@asynMask($(PORT),17,0xFFFF,1)")
    field(SCAN, "I/O Intr")

}

record(mbbiDirect, "$(P):$(R):faults2") {
    field(DTYP, "asynUInt32Digital")
    field(INP, "@asynMask($(PORT),18,0xFFFF,1)")
    field(SCAN, "I/O Intr")

}

########################################################################################
### SETTINGS - Compliant with HAZEMEYER Iocaste Power Supply - Holding Registers Table
########################################################################################

record(ao, "$(P):$(R):current_set") {
    field(DESC, "Set Current")
    field(DTYP, "asynFloat64")  
    field(OUT, "@asyn($(WPORT),2,$(TIMEOUT))FLOAT32_LE") 
    field(EGU, "A")
    field(SCAN, "Passive")
}

record(ao, "$(P):$(R):ramp_set") {
    field(DESC, "Set Ramp")
    field(DTYP, "asynFloat64")  
    field(OUT, "@asyn($(WPORT),6,$(TIMEOUT))FLOAT32_LE") 
    field(EGU, "A/s")
    field(SCAN, "Passive")
}

record(bo, "$(P):$(R):power_on") {
    field(DESC, "Power On Command")
    field(DTYP, "asynUInt32Digital")
    field(OUT, "@asynMask($(WPORT),0,0x0001,1)")
    field(SCAN, "Passive")
    field(ZNAM, "Normal")
    field(ONAM, "Power_ON")
}

record(bo, "$(P):$(R):power_off") {
    field(DESC, "Power Off Command")
    field(DTYP, "asynUInt32Digital")
    field(OUT, "@asynMask($(WPORT),0,0x0002,1)")
    field(SCAN, "Passive")
    field(ZNAM, "Normal")
    field(ONAM, "Power_OFF")
}


record(bo, "$(P):$(R):reset") {
    field(DTYP, "asynUInt32Digital")
    field(OUT, "@asynMask($(WPORT),0,0x0004,1)")
    field(SCAN, "Passive")
    field(ZNAM, "Normal")
    field(ONAM, "Reset")
}


record(bo, "$(P):$(R):ramp_start") {
    field(DESC, "Ramp Command")
    field(DTYP, "asynUInt32Digital")
    field(OUT, "@asynMask($(WPORT),0,0x0008,1)")
}

########################################################################################
### EPIK8s - PVs for UNIMAG Class
########################################################################################

record(ai, "$(P):$(R):CURRENT_RB") {
    field(DESC, "Current Value")
    field(INP, "$(P):$(R):current_rb CP")
    field(EGU, "A")
}

########################################################
### CURRENT_SP : 500 ms before ramp_start - for UNIMAG
########################################################

record(ao, "$(P):$(R):CURRENT_SP") {
    field(DESC, "Set Current with Ramp")
    field(EGU, "A")
    field(FLNK, "$(P):$(R):current_set_calc")
}

record(calcout, "$(P):$(R):current_set_calc") {
    field(INPA, "$(P):$(R):CURRENT_SP")
    field(CALC, "A")
    field(OUT, "$(P):$(R):current_set PP")
    field(FLNK, "$(P):$(R):ramp_delay")
}

record(seq, "$(P):$(R):ramp_delay") {
    field(DESC, "Delay before ramp")
    field(DLY1, "0.5") 
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):ramp_start PP")
}


###################################################
### STATE_RB for UNIMAG
###################################################


record(calcout, "$(P):$(R):STATE_RB_CALC") {
    field(DESC, "State readback")
    field(INPA, "$(P):$(R):powerStatus CP")      # Power Status (1=ON, 2=OFF)
    field(INPB, "$(P):$(R):ready CP")            # Ready (0=NOT READY, 1=READY)
    field(INPC, "$(P):$(R):global_fault CP")     # Global Fault (0=OK, 1=FAULT)
    field(INPD, "$(P):$(R):powerStatus.SEVR CP NMS")   # INVALID = communication error
    field(CALC, "D>=3?5:(C?3:(A=2?0:(A=1&&B?1:2)))")     # Logic
    field(OUT,  "$(P):$(R):STATE_BASE PP")
    field(OOPT, "Every Time")
    field(SCAN, "Passive")                      # Updated from CP
}


record(mbbi, "$(P):$(R):STATE_RB") {
    field(DESC, "State readback")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "FAULT")
    field(THSV, "MAJOR")
    field(FRVL, "4")
    field(FRST, "EXT_INTLK")
    field(FRSV, "MAJOR")
    field(FVVL, "5")
    field(FVST, "CONN_FAULT")
    field(FVSV, "MAJOR")
    field(SXVL, "6")
    field(SXST, "SP_NOT_REACHED")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "ST_NOT_REACHED")
    field(SVSV, "MAJOR")
}

######################################################
### STATE_SP | ON, STABY, RST 
######################################################

record(mbbo, "$(P):$(R):STATE_SP") {
    field(DESC, "State setpoint")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FRVL, "4")
    field(FRST, "FAULT")
    field(FVVL, "5")
    field(FVST, "ERROR")
    field(FLNK, "$(P):$(R):state_dispatcher")
}

record(seq, "$(P):$(R):state_dispatcher") {
    field(SELM, "Specified")
    field(SELL, "$(P):$(R):STATE_SP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):power_on.VAL PP")  # ON (value 1)
    field(DOL4, "1")
    field(LNK4, "$(P):$(R):reset.VAL PP")     # FAULT (value 4)
}

# =================================================
# UNIMAG aligned states and watchdogs
# =================================================
# STATE_RB (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 FAULT (MAJOR) | 4 EXT_INTLK (MAJOR)
#   5 CONN_FAULT (MAJOR, communication errors)
#   6 SP_NOT_REACHED (MINOR, current setpoint not reached)
#   7 ST_NOT_REACHED (MAJOR, commanded state not reached)
#   8.. additional, device specific states
#
# The device logic decodes the plain state (0-5 and the device specific
# ones) into STATE_BASE. The watchdogs below add 6 and 7 on top of it, and
# STATE_FINAL selects what STATE_RB shows: faults win, then ST_NOT_REACHED,
# then SP_NOT_REACHED.
#
# Configuration (db macros, also live PVs):
#   SET_TOLERANCE  (A) readback within this of CURRENT_SP counts as reached
#                      (default 1.0, 0 disables the setpoint check)
#   ZERO_TOLERANCE (A) a zero setpoint counts as reached within this
#                      (default 0.5)
#   SET_TIMEOUT_S  (s) how long the setpoint / state may stay unreached
#                      without progress before it is reported (default 30)
# The timeout restarts on progress (readback getting closer to the setpoint),
# on a new setpoint and on a new state command.

record(ao, "$(P):$(R):SET_TOLERANCE") {
    field(DESC, "Current setpoint tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1.0)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):ZERO_TOLERANCE") {
    field(DESC, "Zero current tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=0.5)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):SET_TIMEOUT_S") {
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

# Plain decoded state (0-5 and device specific), written by the device logic
record(ao, "$(P):$(R):STATE_BASE") {
    field(DESC, "Decoded state without 6/7")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# Final state: faults win, then ST_NOT_REACHED, then SP_NOT_REACHED
record(calcout, "$(P):$(R):STATE_FINAL") {
    field(DESC, "Final state incl. NOT_REACHED")
    field(INPA, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPB, "$(P):$(R):ST_NOT_REACHED NPP NMS")
    field(INPC, "$(P):$(R):SP_NOT_REACHED NPP NMS")
    field(CALC, "(A>=3&&A<=5)?A:(B?7:(C?6:A))")
    field(OUT,  "$(P):$(R):STATE_RB PP")
    field(OOPT, "Every Time")
}

# ---------- setpoint watchdog ----------
# Distance of the readback from the setpoint (from zero for a zero setpoint)
record(calc, "$(P):$(R):SP_ERR") {
    field(DESC, "Setpoint error")
    field(INPA, "$(P):$(R):CURRENT_RB NPP NMS")
    field(INPB, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPC, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(CALC, "ABS(B)<=C?ABS(A):ABS(A-B)")
    field(EGU,  "A")
    field(PREC, "3")
}

# Seconds the setpoint has been unreached without progress. Only counts
# while the supply is ON (or in a device specific active state).
record(calc, "$(P):$(R):SP_WDOG") {
    field(DESC, "Setpoint unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):SP_ERR PP NMS")
    field(INPB, "$(P):$(R):SP_WDOG NPP NMS")
    field(INPC, "$(P):$(R):ERR_LAST NPP NMS")
    field(INPD, "$(P):$(R):SET_TOLERANCE NPP NMS")
    field(INPE, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(INPF, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPG, "$(P):$(R):SP_LAST NPP NMS")
    field(INPH, "$(P):$(R):STATE_BASE NPP NMS")
    field(CALC, "D<=0||H!=1&&H<8?0:(A<=(ABS(F)<=E?E:D)?0:(F!=G||A<C-D/20?0:B+1))")
    field(FLNK, "$(P):$(R):SP_NOT_REACHED")
}

record(calc, "$(P):$(R):SP_NOT_REACHED") {
    field(DESC, "Setpoint not reached in time")
    field(INPA, "$(P):$(R):SP_WDOG NPP NMS")
    field(INPB, "$(P):$(R):SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):SP_LAST")
}

record(calc, "$(P):$(R):SP_LAST") {
    field(DESC, "Previous setpoint")
    field(INPA, "$(P):$(R):CURRENT_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):ERR_LAST")
}

record(calc, "$(P):$(R):ERR_LAST") {
    field(DESC, "Previous setpoint error")
    field(INPA, "$(P):$(R):SP_ERR NPP NMS")
    field(CALC, "A")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# ---------- state watchdog ----------
# Armed by the first state command after boot, so that a supply left running
# does not raise ST_NOT_REACHED just because STATE_SP boots as OFF.
record(calc, "$(P):$(R):ST_ARMED") {
    field(DESC, "State command seen since boot")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):ST_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

# Seconds the commanded state has not been reached. Faults do not count
# (they are shown as such); OFF and STANDBY are both accepted for either.
record(calc, "$(P):$(R):ST_WDOG") {
    field(DESC, "State unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPD, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):ST_ARMED PP NMS")
    field(CALC, "!E||C>=3&&C<=5||A!=B||(A=1?C=1:(A=0||A=2?C=0||C=2:1))?0:D+1")
    field(FLNK, "$(P):$(R):ST_NOT_REACHED")
}

record(calc, "$(P):$(R):ST_NOT_REACHED") {
    field(DESC, "State not reached in time")
    field(INPA, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPB, "$(P):$(R):SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):ST_LAST")
}

record(calc, "$(P):$(R):ST_LAST") {
    field(DESC, "Previous state command")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}
