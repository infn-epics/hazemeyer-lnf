# hz.db - Hazemeyer Power Supply Control Database
# Provides EPICS interface for Hazemeyer power supplies via Modbus

# =========================
# Software Version
# =========================
record(stringout, "$(P):$(R):SWVER") {
    field(DESC, "Software IOC Version")
    field(VAL, "$(SWVER=1.0.1)")
    field(PINI, "YES")
}

# =========================
# Channel Set current (0x0006)
# =========================
record(ao, "$(P):$(R):CURRENT_SP") {
    field(DESC, "Channel Set Current")
    field(EGU, "A")
    field(PREC, "2")
    field(DRVL, "0")
    field(DRVH, "$(IMAX)")
    field(FLNK, "$(P):$(R):CALC_CURRENT_RAW")
}

record(calcout, "$(P):$(R):CALC_CURRENT_RAW") {
    field(DESC, "Convert current to raw value")
    field(INPA, "$(P):$(R):CURRENT_SP")
    field(CALC, "(A * 32767)/$(IMAX)")
    field(OUT, "$(P):$(R):RAW_CURRENT_SP")
    field(FLNK, "$(P):$(R):RAW_CURRENT_SP")
}


record(ao, "$(P):$(R):RAW_CURRENT_SP") {
    field(DESC, "Raw current setpoint")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn($(WPORT),2,$(TIMEOUT))MODBUS_DATA")
    field(PREC, "0")
    field(FLNK, "$(P):$(R):SET_CURRENT_RB")
}


# =========================
# Set current readback (0x000E)
# =========================
record(ai, "$(P):$(R):SET_CURRENT_RB") {
    field(DESC, "Set current readback")
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT),10,$(TIMEOUT))MODBUS_DATA")
    field(LINR, "LINEAR")
    field(ESLO, "0.001")
    field(EGU, "A")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "32.767")
    field(FLNK, "$(P):$(R):AUTO_START_RAMP")

}

record(calcout, "$(P):$(R):AUTO_START_RAMP") {
    field(DESC, "Auto Start Ramp with delay")
    field(CALC, "1")
    field(OUT, "$(P):$(R):DELAY_RAMP.PROC")
}

record(seq, "$(P):$(R):DELAY_RAMP") {
    field(DESC, "Delay before setting ramp bit")
    field(DOL1, "16")
    field(LNK1, "$(P):$(R):RAW_STATE_SP PP")
    field(DLY1, "0.5")
    field(SELM, "All")
}

# =========================
# Channel Set Slew Rate (0x0007)
# =========================
record(ao, "$(P):$(R):SLEWRATE_SP") {
    field(DESC, "Channel Set Slew Rate")
    field(EGU, "A/s")
    field(PREC, "2")
    field(DRVL, "0")
    field(DRVH, "$(IMAX)")
    field(FLNK, "$(P):$(R):CALC_SLEWRATE_RAW")
}

record(calcout, "$(P):$(R):CALC_SLEWRATE_RAW") {
    field(DESC, "Convert slew rate to raw value")
    field(INPA, "$(P):$(R):SLEWRATE_SP")
    field(CALC, "(A * 32767)/$(IMAX)")
    field(OUT, "$(P):$(R):RAW_SLEWRATE_SP")
    field(FLNK, "$(P):$(R):RAW_SLEWRATE_SP")
}

record(ao, "$(P):$(R):RAW_SLEWRATE_SP") {
    field(DESC, "Raw slew rate setpoint")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn($(WPORT),3,$(TIMEOUT))MODBUS_DATA")
    field(PREC, "0")
}

# =========================
# Status Registers (0x000A, 0x000B)
# =========================
record(mbbiDirect, "$(P):$(R):RAW_STATE_RB") {
    field(DESC, "Raw State Register 1")
    field(DTYP, "asynUInt32Digital")
    field(INP, "@asynMask($(PORT) 6 0xFFFF $(TIMEOUT))MODBUS_DATA")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):state_calc")
}

record(mbbiDirect, "$(P):$(R):RAW_STATE2_RB") {
    field(DESC, "Raw State Register 2")
    field(DTYP, "asynUInt32Digital")
    field(INP, "@asynMask($(PORT) 11 0xFFFF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "16")
    field(SCAN, "I/O Intr")

    field(FLNK, "$(P):$(R):state_calc")
}

# =========================
# Maximum Values
# =========================
record(ai, "$(P):$(R):IMAX") {
    field(DESC, "Maximum current")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(VAL, "$(IMAX)")
    field(EGU, "A")
}

record(ai, "$(P):$(R):VMAX") {
    field(DESC, "Maximum voltage")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(VAL, "$(VMAX)")
    field(EGU, "V")
}

# =========================
# Output current readback (0x000B)
# =========================
record(ai, "$(P):$(R):RAW_CURRENT_RB") {
    field(DESC, "Raw output current readback")
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT),7,$(TIMEOUT))MODBUS_DATA")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):CURRENT_RB")
}

record(calc, "$(P):$(R):CURRENT_RB") {
    field(DESC, "Output current readback")
    field(INPA, "$(P):$(R):RAW_CURRENT_RB")
    field(INPB, "$(P):$(R):IMAX")
    field(CALC, "(A / 32767) * B")
    field(PREC, "3")
    field(EGU, "A")
    field(FLNK, "$(P):$(R):RAW_VOLTAGE_RB")

}

# =========================
# Output voltage readback (0x000C)
# =========================
record(ai, "$(P):$(R):RAW_VOLTAGE_RB") {
    field(DESC, "Raw output voltage readback")
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT),8,$(TIMEOUT))MODBUS_DATA")
    field(FLNK, "$(P):$(R):VOLTAGE_RB")
}

record(calc, "$(P):$(R):VOLTAGE_RB") {
    field(DESC, "Output voltage readback")
    field(INPA, "$(P):$(R):RAW_VOLTAGE_RB")
    field(INPB, "$(P):$(R):VMAX")
    field(CALC, "(A / 32767) * B")
    field(PREC, "3")
    field(EGU, "V")
}

# =========================
# Output earth current readback (0x000D)
# =========================
record(ai, "$(P):$(R):EARTH_CURRENT_RB") {
    field(DESC, "Earth current readback")
    field(DTYP, "asynInt32")
    field(INP, "@asyn($(PORT),9,$(TIMEOUT))MODBUS_DATA")
    field(LINR, "LINEAR")
    field(ESLO, "0.001")
    field(EGU, "A")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "32.767")
    field(SCAN, "I/O Intr")
}


# =========================
# Command Register (0x0000)
# =========================
record(ao, "$(P):$(R):RAW_STATE_SP") {
    field(DESC, "Raw command register")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn($(WPORT),0,$(TIMEOUT))MODBUS_DATA")
}

# =========================
# High-Level State Control
# =========================
record(mbbo, "$(P):$(R):STATE_SP") {
    field(DESC, "State setpoint")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FRVL, "4")
    field(FRST, "INTERLOCK")
    field(FVVL, "5")
    field(FVST, "ERROR")
    field(FLNK, "$(P):$(R):SM_RESET")
}

record(seq, "$(P):$(R):state_to_enable") {
    field(DESC, "Convert state to command")
    field(DOL1, "2")   # ON -> Power On (value 2)
    field(LNK1, "$(P):$(R):RAW_STATE_SP PP")
    field(DOL2, "1")   # STANDBY -> Standby (value 1) 
    field(LNK2, "$(P):$(R):RAW_STATE_SP PP")
    field(DOL3, "8")   # RESET -> Reset (value 8)
    field(LNK3, "$(P):$(R):RAW_STATE_SP PP")
    field(SELM, "Specified")
    field(SELL, "$(P):$(R):STATE_SP")
    field(SCAN, "Passive")
}

record(mbbi, "$(P):$(R):STATE_RB") {
    field(DESC, "State readback")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "FAULT")
    field(THSV, "MAJOR")
    field(FRVL, "4")
    field(FRST, "EXT_INTLK")
    field(FRSV, "MAJOR")
    field(FVVL, "5")
    field(FVST, "CONN_FAULT")
    field(FVSV, "MAJOR")
}

# =========================
# Status Interpretation
# =========================
record(bi, "$(P):$(R):ALL_FAULT") {
    field(DESC, "Fault status")
    field(INP, "$(P):$(R):RAW_STATE_RB.B3 MS CP")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(ZSV, "NO_ALARM")
    field(OSV, "MAJOR")
}

record(bi, "$(P):$(R):OPERATIONAL") {
    field(DESC, "Operational status")
    field(INP, "$(P):$(R):RAW_STATE_RB.B0 MS CP")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

record(calcout, "$(P):$(R):state_calc") {
    field(DESC, "Calculate state from status bits")
    field(INPA, "$(P):$(R):OPERATIONAL CP")
    field(INPB, "$(P):$(R):ALL_FAULT CP")
    field(INPC, "$(P):$(R):RAW_STATE_RB.SEVR CP NMS")
    field(CALC, "C>=3?5:(B=1?3:(A=1?1:2))")
    field(OUT, "$(P):$(R):STATE_BASE PP")
    field(OOPT, "Every Time")
}

# =================================================
# UNIMAG aligned states and watchdogs
# =================================================
# STATE_RB (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 FAULT (MAJOR) | 4 EXT_INTLK (MAJOR)
#   5 CONN_FAULT (MAJOR, communication errors)
#   8.. additional, device specific states
#
# The device logic decodes the plain state (0-5 and the device specific
# ones) into STATE_BASE, and
# STATE_FINAL copies it to STATE_RB. A setpoint or state not reached is a
# software state: the watchdogs below report it in STATE_SM.
#
# Configuration (db macros, also live PVs):
#   SET_TOLERANCE  (A) readback within this of CURRENT_SP counts as reached
#                      (default 1.0, 0 disables the setpoint check)
#   ZERO_TOLERANCE (A) a zero setpoint counts as reached within this
#                      (default 0.5)
#   SET_TIMEOUT_S  (s) how long the setpoint / state may stay unreached
#                      without progress before it is reported (default 30)
# The timeout restarts on progress (readback getting closer to the setpoint),
# on a new setpoint and on a new state command.

record(ao, "$(P):$(R):SET_TOLERANCE") {
    field(DESC, "Current setpoint tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1.0)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):ZERO_TOLERANCE") {
    field(DESC, "Zero current tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=0.5)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):SET_TIMEOUT_S") {
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

# Plain decoded state (0-5 and device specific), written by the device logic
record(ao, "$(P):$(R):STATE_BASE") {
    field(DESC, "Decoded state without 6/7")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# Device state to STATE_RB
record(calcout, "$(P):$(R):STATE_FINAL") {
    field(DESC, "Final state")
    field(INPA, "$(P):$(R):STATE_BASE NPP NMS")
    field(CALC, "A")
    field(OUT,  "$(P):$(R):STATE_RB PP")
    field(OOPT, "Every Time")
}

# ---------- setpoint watchdog ----------
# Distance of the readback from the setpoint (from zero for a zero setpoint)
record(calc, "$(P):$(R):SP_ERR") {
    field(DESC, "Setpoint error")
    field(INPA, "$(P):$(R):CURRENT_RB NPP NMS")
    field(INPB, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPC, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(CALC, "ABS(B)<=C?ABS(A):ABS(A-B)")
    field(EGU,  "A")
    field(PREC, "3")
}

# Seconds the setpoint has been unreached without progress. Only counts
# while the supply is ON (or in a device specific active state).
record(calc, "$(P):$(R):SP_WDOG") {
    field(DESC, "Setpoint unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):SP_ERR PP NMS")
    field(INPB, "$(P):$(R):SP_WDOG NPP NMS")
    field(INPC, "$(P):$(R):ERR_LAST NPP NMS")
    field(INPD, "$(P):$(R):SET_TOLERANCE NPP NMS")
    field(INPE, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(INPF, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPG, "$(P):$(R):SP_LAST NPP NMS")
    field(INPH, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPI, "$(P):$(R):SP_ARMED PP NMS")
    field(CALC, "!I||D<=0||H!=1&&H<8?0:(A<=(ABS(F)<=E?E:D)?0:(F!=G||A<C-D/20?0:B+1))")
    field(FLNK, "$(P):$(R):SP_NOT_REACHED")
}

record(calc, "$(P):$(R):SP_NOT_REACHED") {
    field(DESC, "Setpoint not reached in time")
    field(INPA, "$(P):$(R):SP_WDOG NPP NMS")
    field(INPB, "$(P):$(R):SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):SP_LAST")
}

record(calc, "$(P):$(R):SP_LAST") {
    field(DESC, "Previous setpoint")
    field(INPA, "$(P):$(R):CURRENT_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):ERR_LAST")
}

record(calc, "$(P):$(R):ERR_LAST") {
    field(DESC, "Previous setpoint error")
    field(INPA, "$(P):$(R):SP_ERR NPP NMS")
    field(CALC, "A")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# ---------- state watchdog ----------
# Armed by the first state command after boot, so that a supply left running
# does not raise ST_NOT_REACHED just because STATE_SP boots as OFF.
record(calc, "$(P):$(R):ST_ARMED") {
    field(DESC, "State command seen since boot")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):ST_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

# Seconds the commanded state has not been reached. Faults do not count
# (they are shown as such); OFF and STANDBY are both accepted for either.
record(calc, "$(P):$(R):ST_WDOG") {
    field(DESC, "State unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPD, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):ST_ARMED PP NMS")
    field(CALC, "!E||C>=3&&C<=5||A!=B||(A=1?C=1:(A=0||A=2?C=0||C=2:1))?0:D+1")
    field(FLNK, "$(P):$(R):ST_NOT_REACHED")
}

record(calc, "$(P):$(R):ST_NOT_REACHED") {
    field(DESC, "State not reached in time")
    field(INPA, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPB, "$(P):$(R):SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):ST_LAST")
}

record(calc, "$(P):$(R):ST_LAST") {
    field(DESC, "Previous state command")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# ---------- UNIMAG state machine ----------
# STATE_SM tells what the supply is doing; a setpoint or state not reached is
# a software state, reported here and not in STATE_RB:
#   0 READY | 1 GOTOSET | 2 GOTOSTATE | 3 GOZERO | 4 GOPOS | 5 GONEG
#   6 SPNOTSET (MINOR, = SP_NOT_REACHED) | 7 STATENOTSET (MAJOR, = ST_NOT_REACHED)
# A sequencer, when there is one, publishes its step in STATE_SM_STEP
# (GOZERO / GOPOS / GONEG during a polarity change). Otherwise the readback
# tells GOTOSET (GOZERO for a zero setpoint) and the state watchdog GOTOSTATE.
# STATE_SP = RESET restarts both timeouts, clearing SPNOTSET / STATENOTSET.
record(longout, "$(P):$(R):STATE_SM_STEP") {
    field(DESC, "Sequencer step (0 = idle)")
    field(VAL,  "0")
    # STATE_SM_CALC is scanned: a FLNK would not process it, a write to PROC does
    field(OUT,  "$(P):$(R):STATE_SM_CALC.PROC")
}

# Armed by the first setpoint change after boot: CURRENT_SP boots as 0 and
# is not read from the supply, so a supply left running is not reported.
record(calc, "$(P):$(R):SP_ARMED") {
    field(DESC, "Setpoint command seen since boot")
    field(INPA, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPB, "$(P):$(R):SP_LAST NPP NMS")
    field(INPC, "$(P):$(R):SP_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

record(calc, "$(P):$(R):SP_BUSY") {
    field(DESC, "Going to the setpoint")
    field(INPA, "$(P):$(R):SP_ERR NPP NMS")
    field(INPB, "$(P):$(R):SET_TOLERANCE NPP NMS")
    field(INPC, "$(P):$(R):ZERO_TOLERANCE NPP NMS")
    field(INPD, "$(P):$(R):CURRENT_SP NPP NMS")
    field(INPE, "$(P):$(R):SP_ARMED NPP NMS")
    field(INPF, "$(P):$(R):STATE_BASE NPP NMS")
    field(CALC, "E&&B>0&&(F=1||F>=8)&&A>(ABS(D)<=C?C:B)?(ABS(D)<=C?2:1):0")
}

record(calcout, "$(P):$(R):STATE_SM_CALC") {
    field(DESC, "Compute STATE_SM")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):STATE_SM_STEP NPP NMS")
    field(INPB, "$(P):$(R):ST_NOT_REACHED NPP NMS")
    field(INPC, "$(P):$(R):SP_NOT_REACHED NPP NMS")
    field(INPD, "$(P):$(R):ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):SP_BUSY PP NMS")
    field(CALC, "B?7:(C?6:(A?A:(D>0?2:(E=2?3:(E?1:0)))))")
    field(OUT,  "$(P):$(R):STATE_SM PP")
    field(OOPT, "Every Time")
}

record(mbbi, "$(P):$(R):STATE_SM") {
    field(DESC, "UNIMAG state machine")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "READY")
    field(ONVL, "1")
    field(ONST, "GOTOSET")
    field(TWVL, "2")
    field(TWST, "GOTOSTATE")
    field(THVL, "3")
    field(THST, "GOZERO")
    field(FRVL, "4")
    field(FRST, "GOPOS")
    field(FVVL, "5")
    field(FVST, "GONEG")
    field(SXVL, "6")
    field(SXST, "SPNOTSET")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "STATENOTSET")
    field(SVSV, "MAJOR")
}

record(calcout, "$(P):$(R):SM_RESET") {
    field(DESC, "STATE_SP RESET clears the watchdogs")
    field(INPA, "$(P):$(R):STATE_SP NPP NMS")
    field(CALC, "A=3")
    field(OCAL, "0")
    field(DOPT, "Use OCAL")
    field(OUT,  "$(P):$(R):WDOG_CLEAR PP")
    field(OOPT, "When Non-zero")
    field(FLNK, "$(P):$(R):state_to_enable")
}

record(dfanout, "$(P):$(R):WDOG_CLEAR") {
    field(DESC, "Clear the NOT_REACHED watchdogs")
    field(VAL,  "0")
    field(OUTA, "$(P):$(R):SP_WDOG.VAL NPP")
    field(OUTB, "$(P):$(R):ST_WDOG.VAL NPP")
    field(FLNK, "$(P):$(R):WDOG_CLEAR_FAN")
}

record(fanout, "$(P):$(R):WDOG_CLEAR_FAN") {
    field(DESC, "Re-evaluate the NOT_REACHED flags")
    field(LNK1, "$(P):$(R):SP_NOT_REACHED")
    field(LNK2, "$(P):$(R):ST_NOT_REACHED")
}

